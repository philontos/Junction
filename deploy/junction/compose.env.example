# Copy to /etc/junction/compose.env; use absolute host paths.
# Set a distinct project name and ports for a test instance.
JUNCTION_PROJECT_NAME=junction
JUNCTION_IMAGE=junction:RELEASE_COMMIT
JUNCTION_DATA_DIR=/srv/junction/data
JUNCTION_BACKUP_DIR=/srv/junction/backups
JUNCTION_CREDENTIAL_DIR=/srv/junction/credentials
JUNCTION_PROXY_DIR=/srv/junction/proxy
JUNCTION_BIND_ADDRESS=127.0.0.1
JUNCTION_HTTP_PORT=8767
JUNCTION_MEMORY_LIMIT=1g

# Empty for loopback / trusted VPN. Enable https only after checking existing services.
COMPOSE_PROFILES=
JUNCTION_DOMAIN=
# Verified multi-platform image digests; update deliberately with a tested release.
JUNCTION_PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
JUNCTION_CADDY_IMAGE=caddy:2-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
